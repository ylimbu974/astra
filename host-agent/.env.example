# Host Agent config for one PC (or the Raspberry Pi in the "Pi only" setup). Copy to .env next to this file; never commit the real one.

# Name shown in the app (A2), on the Pi page (W1) and in the approval popup.
DEVICE_NAME=DESKTOP-PC

# The Pi registry, by its Tailscale name. Use https:// if you set up `tailscale cert` on the Pi.
REGISTRY_URL=http://pi-server:8000

# Must match HOST_API_KEY in the Pi's registry .env.
HOST_API_KEY=change-me

HOST_PORT=8765
# Address to listen on. Leave empty to bind to this PC's Tailscale IP only (recommended).
# 127.0.0.1 is useful for a first local test.
HOST_BIND=

PAIRING_PIN_TTL_MINUTES=10
FRAME_QUALITY=70        # JPEG quality, MVP streaming
MAX_FPS=15              # MVP cap; raise after WebRTC in V2

# TLS (recommended). Create these with:  tailscale cert <this-pc>.<your-tailnet>.ts.net
# then put the two file paths here. Empty = plain HTTP inside Tailscale's encrypted tunnel.
TLS_CERT_FILE=
TLS_KEY_FILE=

# Optional: override the tailnet name if auto-detection picks the wrong one.
TAILSCALE_HOSTNAME=

# Unattended use. 1 = a phone that is already paired connects without the Allow popup,
# so you can reach a Pi (or PC) that nobody is sitting at. Pairing a new phone still needs
# the PIN and Allow on this screen, and a browser with only the PIN always needs Allow.
# install-pi.sh sets this to 1 for the Pi-only setup. Keep 0 on a PC that other people use.
AUTO_ALLOW_PAIRED_PHONES=0

# Developer only: GET /debug/screenshot.jpg from this PC itself (127.0.0.1). Keep 0.
ENABLE_DEBUG_SCREENSHOT=0
