# Pi Registry config. Copy to .env on the Pi and never commit the real file.
DATABASE_URL=sqlite:////data/registry.db
# A phone token stops working after this many hours without being used, and the
# phone must pair again. 720 h = 30 days. (The sketch suggested 24; that would mean
# re-pairing every day you skip, so the default here is longer.)
SESSION_TOKEN_TTL_HOURS=720

# Shared secret that every Host Agent sends on its calls to the registry.
# Generate one with:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Put the same value in HOST_API_KEY in each PC's host-agent .env.
HOST_API_KEY=change-me

# Your account (one owner in the MVP; Tailscale is the login, so no password is used).
OWNER_EMAIL=owner@example.com

# Heartbeat rules: agents check in every 30 s, offline after 90 s of silence.
OFFLINE_AFTER_SECONDS=90

# The Pi's Tailscale IPv4 address (run: tailscale ip -4). Docker publishes the
# registry only on this address.
PI_TAILSCALE_IP=100.x.y.z
