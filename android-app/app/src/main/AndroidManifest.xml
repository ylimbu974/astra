<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Viewer: Internet and camera (QR pairing), plus vibrate for long-press feedback. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- "Share this phone": screen capture in a foreground service, the Allow pop-up, and
         keeping the screen on while another phone controls this one. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <!-- Lets the app check whether the Tailscale app is installed (E2 "Open Tailscale app"). -->
    <queries>
        <package android:name="com.tailscale.ipn" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Astra">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- C1-C4: the web viewer served by the PC, full screen, landscape-first. -->
        <activity
            android:name=".ViewerActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|smallestScreenSize"
            android:screenOrientation="fullSensor"
            android:theme="@style/Theme.Astra.Viewer"
            android:windowSoftInputMode="adjustResize" />

        <!-- Share this phone: screen capture + link to the Pi while other apps are open. -->
        <service
            android:name=".host.ShareService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- "Astra control": lets the other phone tap, swipe and type. Off until you turn it on. -->
        <service
            android:name=".host.ControlService"
            android:exported="false"
            android:label="@string/control_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_control" />
        </service>

        <!-- The Allow / Deny buttons on the request notification. -->
        <receiver
            android:name=".host.ApprovalReceiver"
            android:exported="false" />
    </application>
</manifest>
